{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fractoid",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"],
  },
  "r2_buckets": [
    {
      "binding": "FRACTOID",
      "bucket_name": "fractoid",
      "remote": true,
    },
  ],
}
